---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% assign base = 'https://jetztunddahanna.com' %}
{% for page in site.data.seo.pages %}
  {% for locale in site.data.seo.locales %}
  <url>
    <loc>{{ base }}/{{ locale.path }}/{% if page.path != '' %}{{ page.path }}{% endif %}</loc>
    <lastmod>{{ site.data.seo.lastmod }}</lastmod>
    {% for alt in site.data.seo.locales %}
    <xhtml:link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ base }}/{{ alt.path }}/{% if page.path != '' %}{{ page.path }}{% endif %}" />
    {% endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ base }}/en/{% if page.path != '' %}{{ page.path }}{% endif %}" />
  </url>
  {% endfor %}
{% endfor %}
</urlset>
